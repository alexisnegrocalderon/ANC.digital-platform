# Runtime: use the pooled Neon endpoint for web requests.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Migrations and administration: use the direct Neon endpoint.
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Optional isolated database or branch for integration tests.
TEST_DATABASE_URL=

PORT=3000

# Manus OAuth and server-side session configuration.
VITE_APP_ID=
OAUTH_SERVER_URL=https://oauth.manus.example
VITE_OAUTH_PORTAL_URL=https://oauth.manus.example
JWT_SECRET=

# One-time secret required to create the first email+password admin account via
# POST /api/auth/password/setup (visit /setup in the browser). The endpoint also
# self-disables once any user has a passwordHash, so remove this from Vercel after
# first use if you want extra defense-in-depth.
ADMIN_SETUP_SECRET=

# Public HTTPS base used for provider checkout redirects and webhook URLs.
PUBLIC_APP_URL=https://your-domain.example

# 32 random bytes encoded as base64; required for encrypted per-business provider accounts.
PAYMENTS_ENCRYPTION_KEY=

# Optional global development credentials. Prefer encrypted per-business accounts in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Mercado Pago marketplace OAuth (server/mercadoPagoConnect.ts). Client ID/Secret come from
# ONE "Marketplace" application registered under ANC's own Mercado Pago account at
# developers.mercadopago.com — the same pair is reused across every client deployment, since
# it identifies ANC as the party collecting the commission. Each client's own end-customer
# purchases still flow through that client's own connected seller account; only the split
# commission lands with ANC.
MERCADOPAGO_MARKETPLACE_CLIENT_ID=
MERCADOPAGO_MARKETPLACE_CLIENT_SECRET=
# Commission ANC takes on every sale, in basis points (150 = 1.5%). Per-deployment: set a
# different value in each client's own Vercel project as needed. Read only at checkout time —
# never stored in the database and never shown or editable in any client-facing UI.
MERCADOPAGO_MARKETPLACE_COMMISSION_BPS=150

# Resend transactional mailing. Keep server-only; never expose as VITE_*.
# Enable only after the client domain is purchased and the sending domain is verified.
MAILING_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=ANC Platform <hello@your-verified-domain.example>

# Development-only demo context. Keep false or unset in production.
DEV_BUSINESS_CONTEXT_ENABLED=false

# Server-to-server control plane JWT verification. Never expose these as VITE_* variables.
CONTROL_PLANE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CONTROL_PLANE_ISSUER=anc-official-admin
CONTROL_PLANE_AUDIENCE=anc-platform-core
CONTROL_PLANE_ENVIRONMENT=production

# Webhook signing from Core to the official ANC admin.
CONTROL_PLANE_WEBHOOK_KEY_ID=core-webhook-2026-01
CONTROL_PLANE_WEBHOOK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
