{
  "name": "anc-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server-dist",
    "start": "NODE_ENV=production node server-dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "neon:smoke": "tsx scripts/neon-smoke.ts",
    "payments:schema-smoke": "tsx scripts/payments-schema-smoke.ts",
    "payments:webhook-smoke": "tsx scripts/payment-webhook-smoke.ts",
    "seed:core": "tsx scripts/seed-core.ts",
    "seed:events": "tsx scripts/seed-events.ts",
    "seed:bookings": "tsx scripts/seed-bookings.ts",
    "bookings:schema-smoke": "tsx scripts/bookings-schema-smoke.ts",
    "bookings:smoke": "tsx scripts/bookings-smoke.ts",
    "bookings:concurrency-smoke": "tsx scripts/bookings-concurrency-smoke.ts",
    "modules:catalog-validate": "tsx scripts/validate-module-catalog.ts",
    "publish:demo-event": "tsx scripts/publish-demo-event.ts",
    "base-modules:smoke": "tsx scripts/base-modules-smoke.ts",
    "pricing:smoke": "tsx scripts/pricing-smoke.ts",
    "course-delivery:smoke": "tsx scripts/course-delivery-smoke.ts",
    "mailing:smoke": "tsx scripts/mailing-smoke.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "jose": "^6.2.9",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.7.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie": "^1.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.1"
}
